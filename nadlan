import json
import pandas as pd
from pyspark.sql import SparkSession
from pyspark.sql.functions import pandas_udf
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType,
    IntegerType,
    BooleanType,
    ArrayType,
)
from src.matcher import analyze_property

spark_output_schema = StructType([
    StructField("score", IntegerType(), False),
    StructField("has_mamad", BooleanType(), False),
    StructField("outdoor_type", StringType(), False),
    StructField("condition", StringType(), False),
    StructField("pros", ArrayType(StringType()), False),
    StructField("cons", ArrayType(StringType()), False),
])

@pandas_udf(spark_output_schema)
def analyze_descriptions_udf(descriptions: pd.Series) -> pd.DataFrame:
    scores, mamads, outdoors, conditions, all_pros, all_cons = [], [], [], [], [], []

    for text in descriptions:
        try:
            features, score = analyze_property(str(text))
            scores.append(score)
            mamads.append(features.has_mamad)
            outdoors.append(features.outdoor_space_type)
            conditions.append(features.property_condition)
            all_pros.append(features.summary_pros)
            all_cons.append(features.summary_cons)
        except Exception:
            scores.append(0)
            mamads.append(False)
            outdoors.append("לא ידוע")
            conditions.append("לא ידוע")
            all_pros.append([])
            all_cons.append(["שגיאה בניתוח"])

    return pd.DataFrame({
        "score": scores,
        "has_mamad": mamads,
        "outdoor_type": outdoors,
        "condition": conditions,
        "pros": all_pros,
        "cons": all_cons,
    })

def run_spark_analysis(listings_data: list, min_score: int = 70) -> list:
    spark = SparkSession.builder \
        .appName("PisgatZeevRealEstateEngine") \
        .master("local[*]") \
        .config("spark.sql.execution.arrow.pyspark.enabled", "true") \
        .getOrCreate()

    rdd = spark.sparkContext.parallelize([json.dumps(d) for d in listings_data])
    df = spark.read.json(rdd)

    df_evaluated = df.withColumn("eval", analyze_descriptions_udf("description"))
    qualified_df = df_evaluated.filter(f"eval.score >= {min_score}").orderBy("eval.score", ascending=False)

    rows = qualified_df.collect()
    results = []
    for r in rows:
        item = r.asDict(recursive=True)
        eval_data = item.pop("eval", {})
        item.update(eval_data)
        results.append(item)

    spark.stop()
    return results
EOF

