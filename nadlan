from typing import Optional, Literal, List
from pydantic import BaseModel, Field
from google import genai
from google.genai import types

class PropertyFeatures(BaseModel):
    has_mamad: bool = Field(description="האם יש בדירה ממ\"ד")
    has_garden_or_wrap_balcony: bool = Field(description="האם יש גינה או מרפסת היקפית רחבה")
    outdoor_space_type: Literal["גינה", "מרפסת היקפית", "מרפסת רגילה", "ללא"]
    property_condition: Literal["חדש מקבלן", "משופץ מהיסוד", "משופץ חלקית", "שמור", "דורש שיפוץ", "לא ידוע"]
    construction_year: Optional[int] = None
    large_rooms: bool = Field(description="האם החדרים מרווחים וגדולים")
    physical_accessibility: Literal["מעולה", "בינונית", "מוגבלת", "לא ידוע"]
    transit_accessibility: Literal["מעולה", "טובה", "רגילה", "רחוק"]
    summary_pros: List[str]
    summary_cons: List[str]

def calculate_match_score(features: PropertyFeatures) -> int:
    score = 0
    if features.has_garden_or_wrap_balcony:
        score += 25
    elif features.outdoor_space_type == "מרפסת רגילה":
        score += 10

    if features.has_mamad:
        score += 20

    if features.property_condition in ["חדש מקבלן", "משופץ מהיסוד"]:
        score += 20
    elif features.property_condition == "משופץ חלקית":
        score += 12
    elif features.property_condition == "שמור":
        score += 6

    if features.construction_year and features.construction_year >= 2010:
        score = min(100, score + 5)

    if features.large_rooms:
        score += 15

    if features.physical_accessibility == "מעולה":
        score += 10
    elif features.physical_accessibility == "בינונית":
        score += 5

    if features.transit_accessibility == "מעולה":
        score += 10
    elif features.transit_accessibility == "טובה":
        score += 6
    elif features.transit_accessibility == "רגילה":
        score += 3

    return min(100, score)

def analyze_property(raw_text: str) -> tuple[PropertyFeatures, int]:
    client = genai.Client()
    prompt = f"""
אתה סוכן נדל"ן מומחה שמנתח מודעות עבור משפחה המחפשת דירה גדולה בפסגת זאב (מעל 120 מ"ר / 6 חדרים).
דרישות קריטיות: גינה או מרפסת היקפית, ממ"ד, מצב משופץ ומעלה, חדרים גדולים, נגישות מעולה ותחבורה.

נתח את המודעה וחלץ את המאפיינים במדויק:
{raw_text}
"""
    response = client.models.generate_content(
        model="gemini-2.5-flash",
        contents=prompt,
        config=types.GenerateContentConfig(
            response_mime_type="application/json",
            response_schema=PropertyFeatures,
            temperature=0.1
        ),
    )
    features = PropertyFeatures.model_validate_json(response.text)
    score = calculate_match_score(features)
    return features, score
EOF

