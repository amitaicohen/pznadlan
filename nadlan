import os
import smtplib
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText

def send_alert_email(matches: list):
    if not matches:
        print("לא נמצאו נכסים העומדים בסף ההתאמה (70+). המייל בוטל.")
        return

    smtp_server = os.getenv("SMTP_SERVER", "smtp.gmail.com")
    smtp_port = int(os.getenv("SMTP_PORT", "587"))
    sender_email = os.getenv("SENDER_EMAIL")
    sender_password = os.getenv("SENDER_PASSWORD")
    recipient_email = os.getenv("RECIPIENT_EMAIL", sender_email)

    msg = MIMEMultipart("alternative")
    msg["Subject"] = f"🏠 נמצאו {len(matches)} נכסים רלוונטיים בפסגת זאב (ציון 70+)"
    msg["From"] = sender_email
    msg["To"] = recipient_email

    cards_html = ""
    for prop in matches:
        pros_li = "".join([f"<li>{p}</li>" for p in prop.get("pros", [])])
        cons_li = "".join([f"<li>{c}</li>" for c in prop.get("cons", [])])

        cards_html += f"""
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 16px; margin-bottom: 20px; font-family: Arial, sans-serif; direction: rtl; text-align: right; background-color: #fafafa;">
            <h3 style="margin-top: 0; color: #1a73e8;">
                {prop['street']} | {prop['rooms']} חדרים | {prop['sqm']} מ"ר
                <span style="background-color: #34a853; color: white; padding: 4px 8px; border-radius: 4px; font-size: 14px; float: left;">
                    ציון: {prop['score']}/100
                </span>
            </h3>
            <p><strong>מחיר:</strong> {prop['price']}</p>
            <p><strong>ממ"ד:</strong> {'כן ✅' if prop['has_mamad'] else 'אין/לא צוין ❌'} | <strong>שטח חוץ:</strong> {prop['outdoor_type']} | <strong>מצב:</strong> {prop['condition']}</p>
            <div style="background-color: #fff; padding: 10px; border-radius: 4px; border: 1px solid #eee;">
                <p style="margin: 4px 0; color: #2e7d32;"><strong>יתרונות:</strong></p>
                <ul style="margin: 0; padding-right: 20px;">{pros_li}</ul>
                <p style="margin: 4px 0; color: #c62828;"><strong>לבירור:</strong></p>
                <ul style="margin: 0; padding-right: 20px;">{cons_li}</ul>
            </div>
            <p style="margin-top: 12px; font-size: 13px; color: #555;"><strong>תיאור מלא:</strong><br>{prop['description']}</p>
            <p><a href="{prop['link']}" style="display: inline-block; padding: 8px 16px; background-color: #1a73e8; color: white; text-decoration: none; border-radius: 4px;">צפייה במודעה המקורית</a></p>
        </div>
        """

    full_html = f"""
    <html dir="rtl">
    <body>
        <h2>דוח סריקת נדל"ן — פסגת זאב</h2>
        <p>להלן הנכסים שעברו את סף הסינון:</p>
        {cards_html}
    </body>
    </html>
    """

    msg.attach(MIMEText(full_html, "html"))

    with smtplib.SMTP(smtp_server, smtp_port) as server:
        server.starttls()
        server.login(sender_email, sender_password)
        server.sendmail(sender_email, recipient_email, msg.as_string())
    print(f"המייל נשלח בהצלחה ל-{recipient_email}.")
EOF

